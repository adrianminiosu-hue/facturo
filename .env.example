NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ANAF e-Factura TEST
# 1. Cloud cert + paperLESS vToken + Authenticator on the machine that clicks Connect.
# 2. Document de confirmare and SPV enrollment for the emitting CUI:
#    https://www.anaf.ro/InregPersFizicePublic/#tabs-2
# 3. Developer app at https://www.anaf.ro/InregOauth/ with the E-Factura service enabled.
#    Register the redirect URI exactly as ANAF_OAUTH_REDIRECT_URI (HTTPS tunnel for local,
#    public domain later). ANAF login uses the qualified cert in the browser; the private
#    key never enters Facturo.
# 4. Set MODE=test after credentials exist. Use simulate only when ANAF is unavailable.

ANAF_OAUTH_CLIENT_ID=
ANAF_OAUTH_CLIENT_SECRET=
ANAF_OAUTH_REDIRECT_URI=https://your-host/api/efactura/oauth/callback
ANAF_EFACTURA_BASE=https://api.anaf.ro/test/FCTEL/rest
ANAF_EFACTURA_MODE=test
